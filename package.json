{
  "name": "land-shepherd",
  "version": "0.1.0",
  "description": "2D sprite-based plant growing simulation with procedural generation",
  "scripts": {
    "verify": "node scripts/verify-changes.js",
    "verify:baseline": "node scripts/verify-changes.js --baseline",
    "verify:verbose": "node scripts/verify-changes.js --verbose",
    "verify:interactive": "node scripts/verify-changes.js --interactive",
    "verify:screenshot-only": "node scripts/verify-changes.js --screenshot-only",
    "verify:log-only": "node scripts/verify-changes.js --log-only",
    "test": "playwright test",
    "test:interactive": "playwright test tests/interactive.spec.js",
    "test:decomp": "cross-env TEST_DECOMP_OM=true playwright test",
    "test:balance": "cross-env TEST_BALANCE=true playwright test tests/ecosystem-balance.spec.js --timeout=600000",
    "test:overlay": "cross-env TEST_OVERLAY=true playwright test",
    "test:weather": "cross-env TEST_WEATHER=true playwright test",
    "test:weather-soil": "cross-env TEST_WEATHER_SOIL=true playwright test",
    "test:nitrogen": "cross-env TEST_NITROGEN_REGEN=true playwright test",
    "test:splash": "cross-env TEST_SPLASH=true playwright test --headed",
    "test:context-menu": "cross-env TEST_FUNCTIONAL=true playwright test --headed",
    "dev": "npx http-server -p 8080",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "webgl",
    "procedural-generation",
    "game",
    "simulation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "cross-env": "^10.1.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  }
}
