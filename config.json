{
    "debug": {
        "enabled": true,
        "showFPS": true,
        "showGeometryCount": true,
        "showPlayerPosition": true,
        "refreshRate": 144
    },
    "graphics": {
        "vsync": true,
        "backgroundColor": [0.5, 0.5, 0.5, 1.0]
    },
    "time": {
        "initialTimeScale": 0.1,
        "realSecondsPerGameDay": 10,
        "timeScalePresets": {
            "pause": 0,
            "verySlow": 0.05,
            "slow": 0.1,
            "normal": 0.5,
            "fast": 1.0,
            "veryFast": 5.0
        }
    },
    "world": {
        "terrain": {
            "seed": null,
            "generation": {
                "logStats": true
            },
            "water": {
                "rivers": {
                    "enabled": true,
                    "count": 2,
                    "widthMin": 2,
                    "widthMax": 4,
                    "windiness": 0.3,
                    "depthRange": [30, 50]
                },
                "lakes": {
                    "enabled": true,
                    "count": 3,
                    "radiusMin": 3,
                    "radiusMax": 8,
                    "depthRange": [60, 90],
                    "irregularity": 0.4,
                    "minEdgeDistance": 5
                },
                "fertilityBoost": {
                    "enabled": true,
                    "radius": 3,
                    "nitrogenBonus": 20,
                    "waterRetentionBonus": 30
                }
            }
        },
        "map": {
            "gridWidth": 50,
            "gridHeight": 50,
            "cellSize": 20
        },
        "plants": {
            "stuntGracePeriod": 7,
            "starvationReturnMultiplier": 0.5,
            "reproduction": {
                "enableLogging": false
            },
            "decomposition": {
                "enableLogging": false
            }
        },
        "soil": {
            "decomposition": {
                "enabled": true,
                "organicMatterDecayPerDay": 0.3,
                "nitrogenReleaseRatio": 0.4,
                "phosphorusReleaseRatio": 0.3,
                "minimumOMForBreakdown": 10,
                "enableLogging": false,
                "loggingInterval": 5,
                "radius": 1,
                "activityWindowDays": 30,
                
                "weatherModifiers": {
                    "rainy": {
                        "base": 1.3,
                        "intensityScale": 0.4
                    },
                    "cloudy": 1.0,
                    "sunny": 0.7
                }
            },
            "fertility": {
                "hotspots": 8,
                "baseValue": 30,
                "maxIntensity": 85,
                "falloffRate": 0.15,
                "noiseIntensity": 10,
                "radiusMin": 8,
                "radiusMax": 20,
                "nutrientVariation": {
                    "nitrogen": 10,
                    "phosphorus": 15,
                    "potassium": 12,
                    "organicMatter": 8
                }
            },
            "water": {
                "hotspots": 5,
                "baseValue": 20,
                "maxIntensity": 90,
                "falloffRate": 0.12,
                "noiseIntensity": 8,
                "radiusMin": 6,
                "radiusMax": 18
            },
            "pollution": {
                "hotspots": 3,
                "baseValue": 5,
                "maxIntensity": 80,
                "falloffRate": 0.08,
                "noiseIntensity": 5,
                "radiusMin": 10,
                "radiusMax": 25
            }
        },
        "textures": {
            "soilTextureSize": 20,
            "generateVariations": 2,
            "waterPixelThreshold": 20,
            "pollutionPixelThreshold": 15,
            "waterMaxCoverage": 0.25,
            "pollutionMaxCoverage": 0.15,
            "waterIntensityLevels": [
                { "threshold": 20, "coverage": 0.05, "color": [50, 120, 255] },
                { "threshold": 40, "coverage": 0.15, "color": [30, 100, 255] },
                { "threshold": 70, "coverage": 0.25, "color": [10, 80, 255] }
            ],
            "pollutionIntensityLevels": [
                { "threshold": 15, "coverage": 0.03, "color": [100, 255, 120] },
                { "threshold": 35, "coverage": 0.08, "color": [50, 255, 80] },
                { "threshold": 60, "coverage": 0.15, "color": [20, 255, 60] }
            ]
        },
        "weather": {
            "enabled": true,
            "initialState": "sunny",
            "transitionLogging": false,
            
            "states": {
                "sunny": {
                    "minDuration": 2,
                    "maxDuration": 5,
                    "nextStates": ["cloudy", "rainy", "sunny"]
                },
                "cloudy": {
                    "minDuration": 1,
                    "maxDuration": 2,
                    "nextStates": ["rainy", "sunny"]
                },
                "rainy": {
                    "minDuration": 1,
                    "maxDuration": 3,
                    "rainIntensityMin": 0.4,
                    "rainIntensityMax": 1.0,
                    "nextStates": ["cloudy", "sunny", "rainy"]
                }
            },
            
            "particles": {
                "maxParticles": 1000,
                "particleSizeMin": 1,
                "particleSizeMax": 3,
                "fallSpeedMin": 200,
                "fallSpeedMax": 400,
                "color": [100, 180, 255, 200],
                "spawnHeightOffset": 50
            },
            
            "splashes": {
                "enabled": true,
                "spawnProbability": 0.15,
                "particleCountMin": 2,
                "particleCountMax": 4,
                "lifetimeMin": 0.1,
                "lifetimeMax": 0.3,
                "speedMin": 20,
                "speedMax": 60,
                "color": [255, 255, 255, 200]
            },
            
            "soilEffects": {
                "rainWaterIncreasePerDay": 15,
                "sunEvaporationPerDay": 5,
                "cloudyEvaporationPerDay": 2,
                "rainNitrogenRestorePerDay": 0.0
            }
        },
        
        "lighting": {
            "enabled": true,
            "transitionSpeed": 1.0,
            
            "timeOfDay": {
                "night": {
                    "hours": [0, 6],
                    "color": [0.15, 0.18, 0.35],
                    "brightness": 0.25
                },
                "earlyMorning": {
                    "hours": [6, 8],
                    "color": [0.95, 0.75, 0.55],
                    "brightness": 0.65
                },
                "morning": {
                    "hours": [8, 12],
                    "color": [1.0, 0.98, 0.92],
                    "brightness": 0.95
                },
                "midday": {
                    "hours": [12, 14],
                    "color": [1.0, 1.0, 1.0],
                    "brightness": 1.0
                },
                "afternoon": {
                    "hours": [14, 18],
                    "color": [1.0, 0.95, 0.85],
                    "brightness": 0.95
                },
                "evening": {
                    "hours": [18, 20],
                    "color": [0.98, 0.85, 0.70],
                    "brightness": 0.75
                },
                "sunset": {
                    "hours": [20, 21],
                    "color": [1.0, 0.60, 0.35],
                    "brightness": 0.50
                },
                "dusk": {
                    "hours": [21, 23],
                    "color": [0.45, 0.40, 0.60],
                    "brightness": 0.35
                }
            },
            
            "weatherModifiers": {
                "sunny": {
                    "brightnessMultiplier": 1.0,
                    "colorTint": [1.0, 1.0, 1.0]
                },
                "cloudy": {
                    "brightnessMultiplier": 0.85,
                    "colorTint": [0.95, 0.95, 1.0]
                },
                "rainy": {
                    "brightnessMultiplier": 0.70,
                    "brightnessIntensityScale": 0.15,
                    "colorTint": [0.85, 0.90, 1.10]
                }
            }
        }
    }
}