{
    "debug": {
        "enabled": true,
        "showFPS": true,
        "showGeometryCount": true,
        "showPlayerPosition": true,
        "refreshRate": 144
    },
    "graphics": {
        "vsync": true,
        "backgroundColor": [0.5, 0.5, 0.5, 1.0]
    },
    "time": {
        "initialTimeScale": 0.1,
        "realSecondsPerGameDay": 10,
        "timeScalePresets": {
            "pause": 0,
            "verySlow": 0.05,
            "slow": 0.1,
            "normal": 0.5,
            "fast": 1.0,
            "veryFast": 5.0,
            "veryVeryFast": 10.0,
            "ultraFast": 20.0
        }
    },
    "world": {
        "terrain": {
            "seed": null,
            "generation": {
                "logStats": true
            },
            "water": {
                "rivers": {
                    "enabled": true,
                    "count": 2,
                    "widthMin": 2,
                    "widthMax": 4,
                    "windiness": 0.3,
                    "depthRange": [30, 50]
                },
                "lakes": {
                    "enabled": true,
                    "count": 3,
                    "radiusMin": 3,
                    "radiusMax": 8,
                    "depthRange": [60, 90],
                    "irregularity": 0.4,
                    "minEdgeDistance": 5
                },
                "riverFertility": {
                    "enabled": true,
                    "radius": 3,
                    "nitrogenBonus": 25,
                    "waterRetentionBonus": 30,
                    "organicMatterBonus": 5
                },
                "lakeFertility": {
                    "enabled": true,
                    "radius": 2,
                    "nitrogenBonus": 15,
                    "waterRetentionBonus": 25,
                    "organicMatterBonus": 3
                },
                "floodEvents": {
                    "enabled": true,
                    "intervalDays": 8,
                    "radius": 5,
                    "nitrogenBonus": 25,
                    "phosphorusBonus": 15,
                    "potassiumBonus": 10,
                    "organicMatterBonus": 20,
                    "enableLogging": true
                },
                "waterTable": {
                    "enabled": true,
                    "radius": 4,
                    "seepingRatePerDay": 0.5,
                    "maxWaterRetention": 90,
                    "description": "Gradual moisture seeping from water table near water bodies"
                }
            }
        },
        "rendering": {
            "projection": "isometric",
            "isometric": {
                "tileWidth": 40,
                "tileHeight": 20,
                "depthSortingEnabled": true,
                "description": "2:1 isometric projection with depth sorting"
            }
        },
        "map": {
            "gridWidth": 50,
            "gridHeight": 50,
            "cellSize": 20
        },
        "plants": {
            "stuntGracePeriod": 7,
            "starvationReturnMultiplier": 0.5,
            "rootDepthProfiles": {
                "shallow": { "surface": 1.0, "deep": 0.2 },
                "medium": { "surface": 0.8, "deep": 0.6 },
                "deep": { "surface": 0.5, "deep": 1.0 }
            },
            "dailyNutrientConsumption": {
                "enabled": true,
                "baseDailyRate": {
                    "nitrogen": 0.5,
                    "phosphorus": 0.3,
                    "potassium": 0.2,
                    "organicMatter": 0.1
                },
                "categoryMultipliers": {
                    "tree": 0.2,
                    "herb": 1.0,
                    "groundcover": 1.0
                },
                "stageMultipliers": {
                    "Seedling": 0.3,
                    "Sapling": 0.5,
                    "YoungTree": 0.7,
                    "MatureTree": 0.0,
                    "Sprouting": 0.4,
                    "Mature": 1.0,
                    "Flowering": 1.2,
                    "Withered": 0.0
                },
                "description": "Daily nutrient consumption independent of growth stage advancement"
            },
            "reproduction": {
                "enableLogging": true,
                "costMultiplier": 1.0,
                "description": "Global reproduction settings (costMultiplier allows easy tuning)"
            },
            "decomposition": {
                "enableLogging": false
            },
            "genetics": {
                "enabled": true,
                "visualVariation": {
                    "heightRange": [0.7, 1.3],
                    "widthRange": [0.7, 1.3],
                    "foliageRange": [0.6, 1.4],
                    "colorTintRange": [-20, 20]
                },
                "nutrientVariation": {
                    "efficiencyRange": [0.8, 1.2]
                },
                "inheritance": {
                    "mutationChance": 0.1,
                    "mutationStrength": 0.15
                }
            },
            "ui": {
                "speciesPalette": {
                    "enabled": true,
                    "position": "bottom-left",
                    "showLayerInfo": true
                }
            },
            "layers": {
                "enabled": true,
                "renderOffsets": {
                    "bottom": 0,
                    "middle": 5,
                    "top": 15
                },
                "renderLogging": false,
                "lightFiltering": {
                    "enabled": true,
                    "treeShadeStrength": 0.5,
                    "shadeRadius": 1
                },
                "nutrientPriority": {
                    "enabled": false
                }
            },
            "starvationVisualization": {
                "enabled": true,
                "stages": {
                    "healthy": {
                        "nutrientThreshold": 0.8,
                        "colorIntensity": 1.0,
                        "alphaMultiplier": 1.0,
                        "sizeMultiplier": 1.0
                    },
                    "stressed": {
                        "nutrientThreshold": 0.5,
                        "daysStuntedMax": 2,
                        "colorIntensity": 0.7,
                        "alphaMultiplier": 0.95,
                        "sizeMultiplier": 0.95
                    },
                    "starving": {
                        "nutrientThreshold": 0.2,
                        "daysStuntedMax": 5,
                        "colorIntensity": 0.4,
                        "alphaMultiplier": 0.8,
                        "sizeMultiplier": 0.85
                    },
                    "critical": {
                        "nutrientThreshold": 0.0,
                        "daysStuntedMax": 999,
                        "colorIntensity": 0.2,
                        "alphaMultiplier": 0.6,
                        "sizeMultiplier": 0.7
                    }
                },
                "enhancedColorIntensity": {
                    "nitrogen": 0.6,
                    "phosphorus": 0.7,
                    "potassium": 0.8,
                    "organicMatter": 0.5
                },
                "description": "Multi-stage starvation visualization with wilting effects"
            }
        },
        "soil": {
            "decomposition": {
                "enabled": true,
                "organicMatterDecayPerDay": 0.3,
                "nitrogenReleaseRatio": 0.5,
                "phosphorusReleaseRatio": 0.3,
                "minimumOMForBreakdown": 10,
                "enableLogging": false,
                "loggingInterval": 5,
                "radius": 1,
                "activityWindowDays": 30,
                
                "weatherModifiers": {
                    "rainy": {
                        "base": 1.3,
                        "intensityScale": 0.4
                    },
                    "cloudy": 1.0,
                    "sunny": 0.7
                },
                
                "riparianZone": {
                    "enabled": true,
                    "radius": 2,
                    "decayMultiplier": 0.5,
                    "organicInputPerDay": 0.3,
                    "description": "Riparian zones accumulate more OM from aquatic sources"
                }
            },
            "nitrogenRegeneration": {
                "enabled": true,
                "baseRatePerDay": 0.25,
                "riparianMultiplier": 2.5,
                "description": "Nitrogen fixation via bacteria and atmospheric deposition"
            },
            "fertility": {
                "hotspots": 8,
                "baseValue": 30,
                "maxIntensity": 85,
                "falloffRate": 0.15,
                "noiseIntensity": 10,
                "radiusMin": 8,
                "radiusMax": 20,
                "nutrientVariation": {
                    "nitrogen": 10,
                    "phosphorus": 15,
                    "potassium": 12,
                    "organicMatter": 8
                }
            },
            "water": {
                "hotspots": 5,
                "baseValue": 20,
                "maxIntensity": 90,
                "falloffRate": 0.12,
                "noiseIntensity": 8,
                "radiusMin": 6,
                "radiusMax": 18
            },
            "pollution": {
                "hotspots": 3,
                "baseValue": 5,
                "maxIntensity": 80,
                "falloffRate": 0.08,
                "noiseIntensity": 5,
                "radiusMin": 10,
                "radiusMax": 25
            }
        },
        "textures": {
            "soilTextureSize": 20,
            "generateVariations": 2,
            "waterPixelThreshold": 20,
            "pollutionPixelThreshold": 15,
            "waterMaxCoverage": 0.25,
            "pollutionMaxCoverage": 0.15,
            "waterIntensityLevels": [
                { "threshold": 20, "coverage": 0.05, "color": [50, 120, 255] },
                { "threshold": 40, "coverage": 0.15, "color": [30, 100, 255] },
                { "threshold": 70, "coverage": 0.25, "color": [10, 80, 255] }
            ],
            "pollutionIntensityLevels": [
                { "threshold": 15, "coverage": 0.03, "color": [100, 255, 120] },
                { "threshold": 35, "coverage": 0.08, "color": [50, 255, 80] },
                { "threshold": 60, "coverage": 0.15, "color": [20, 255, 60] }
            ]
        },
        "weather": {
            "enabled": true,
            "initialState": "sunny",
            "transitionLogging": false,
            
            "states": {
                "sunny": {
                    "minDuration": 2,
                    "maxDuration": 5,
                    "nextStates": ["cloudy", "rainy", "sunny"]
                },
                "cloudy": {
                    "minDuration": 1,
                    "maxDuration": 2,
                    "nextStates": ["rainy", "sunny"]
                },
                "rainy": {
                    "minDuration": 1,
                    "maxDuration": 3,
                    "rainIntensityMin": 0.4,
                    "rainIntensityMax": 1.0,
                    "nextStates": ["cloudy", "sunny", "rainy"]
                }
            },
            
            "particles": {
                "maxParticles": 1000,
                "particleSizeMin": 1,
                "particleSizeMax": 3,
                "fallSpeedMin": 200,
                "fallSpeedMax": 400,
                "color": [100, 180, 255, 200],
                "spawnHeightOffset": 50
            },
            
            "splashes": {
                "enabled": true,
                "spawnProbability": 0.15,
                "particleCountMin": 2,
                "particleCountMax": 4,
                "lifetimeMin": 0.1,
                "lifetimeMax": 0.3,
                "speedMin": 20,
                "speedMax": 60,
                "color": [255, 255, 255, 200]
            },
            
                "soilEffects": {
                "rainWaterIncreasePerDay": 15,
                "sunEvaporationPerDay": 5,
                "cloudyEvaporationPerDay": 2,
                "rainNitrogenRestorePerDay": 3.0,
                "leaching": {
                    "enabled": false,
                    "nitrogenLeachRate": 0.03,
                    "phosphorusLeachRate": 0.005,
                    "potassiumLeachRate": 0.01,
                    "organicMatterLeachRate": 0.0,
                    "transferEfficiency": 0.95,
                    "intensityMultiplier": {
                        "light": 0.2,
                        "heavy": 0.6
                    },
                    "riparianResistance": {
                        "enabled": true,
                        "radius": 3,
                        "leachingMultiplier": 0.2,
                        "description": "Floodplain soils resist leaching due to clay content deposited by floods"
                    }
                }
            }
        },
        
        "lighting": {
            "enabled": true,
            "transitionSpeed": 1.0,
            
            "timeOfDay": {
                "night": {
                    "hours": [0, 6],
                    "color": [0.15, 0.18, 0.35],
                    "brightness": 0.25
                },
                "earlyMorning": {
                    "hours": [6, 8],
                    "color": [0.95, 0.75, 0.55],
                    "brightness": 0.65
                },
                "morning": {
                    "hours": [8, 12],
                    "color": [1.0, 0.98, 0.92],
                    "brightness": 0.95
                },
                "midday": {
                    "hours": [12, 14],
                    "color": [1.0, 1.0, 1.0],
                    "brightness": 1.0
                },
                "afternoon": {
                    "hours": [14, 18],
                    "color": [1.0, 0.95, 0.85],
                    "brightness": 0.95
                },
                "evening": {
                    "hours": [18, 20],
                    "color": [0.98, 0.85, 0.70],
                    "brightness": 0.75
                },
                "sunset": {
                    "hours": [20, 21],
                    "color": [1.0, 0.60, 0.35],
                    "brightness": 0.50
                },
                "dusk": {
                    "hours": [21, 23],
                    "color": [0.45, 0.40, 0.60],
                    "brightness": 0.35
                }
            },
            
            "weatherModifiers": {
                "sunny": {
                    "brightnessMultiplier": 1.0,
                    "colorTint": [1.0, 1.0, 1.0]
                },
                "cloudy": {
                    "brightnessMultiplier": 0.85,
                    "colorTint": [0.95, 0.95, 1.0]
                },
                "rainy": {
                    "brightnessMultiplier": 0.70,
                    "brightnessIntensityScale": 0.15,
                    "colorTint": [0.85, 0.90, 1.10]
                }
            }
        }
    }
}