{
    "debug": {
        "enabled": true,
        "showFPS": true,
        "showGeometryCount": true,
        "showPlayerPosition": true,
        "refreshRate": 144
    },
    "graphics": {
        "vsync": true,
        "backgroundColor": [0.5, 0.5, 0.5, 1.0]
    },
    "time": {
        "initialTimeScale": 1.0,
        "realSecondsPerGameDay": 10,
        "timeScalePresets": {
            "pause": 0,
            "slow": 0.5,
            "normal": 1.0,
            "fast": 5.0,
            "veryFast": 20.0
        }
    },
    "world": {
        "map": {
            "gridWidth": 50,
            "gridHeight": 50,
            "cellSize": 20
        },
        "plants": {
            "stuntGracePeriod": 7,
            "starvationReturnMultiplier": 0.5,
            "reproduction": {
                "enableLogging": true
            },
            "decomposition": {
                "enableLogging": true
            }
        },
        "soil": {
            "fertility": {
                "hotspots": 8,
                "baseValue": 30,
                "maxIntensity": 85,
                "falloffRate": 0.15,
                "noiseIntensity": 10,
                "radiusMin": 8,
                "radiusMax": 20,
                "nutrientVariation": {
                    "nitrogen": 10,
                    "phosphorus": 15,
                    "potassium": 12,
                    "organicMatter": 8
                }
            },
            "water": {
                "hotspots": 5,
                "baseValue": 20,
                "maxIntensity": 90,
                "falloffRate": 0.12,
                "noiseIntensity": 8,
                "radiusMin": 6,
                "radiusMax": 18
            },
            "pollution": {
                "hotspots": 3,
                "baseValue": 5,
                "maxIntensity": 80,
                "falloffRate": 0.08,
                "noiseIntensity": 5,
                "radiusMin": 10,
                "radiusMax": 25
            }
        },
        "textures": {
            "soilTextureSize": 20,
            "generateVariations": 2,
            "waterPixelThreshold": 20,
            "pollutionPixelThreshold": 15,
            "waterMaxCoverage": 0.25,
            "pollutionMaxCoverage": 0.15,
            "waterIntensityLevels": [
                { "threshold": 20, "coverage": 0.05, "color": [50, 120, 255] },
                { "threshold": 40, "coverage": 0.15, "color": [30, 100, 255] },
                { "threshold": 70, "coverage": 0.25, "color": [10, 80, 255] }
            ],
            "pollutionIntensityLevels": [
                { "threshold": 15, "coverage": 0.03, "color": [100, 255, 120] },
                { "threshold": 35, "coverage": 0.08, "color": [50, 255, 80] },
                { "threshold": 60, "coverage": 0.15, "color": [20, 255, 60] }
            ]
        },
        "weather": {
            "enabled": true,
            "initialState": "sunny",
            "transitionLogging": false,
            
            "states": {
                "sunny": {
                    "minDuration": 2,
                    "maxDuration": 5,
                    "nextStates": ["cloudy", "rainy", "sunny"]
                },
                "cloudy": {
                    "minDuration": 1,
                    "maxDuration": 2,
                    "nextStates": ["rainy", "sunny"]
                },
                "rainy": {
                    "minDuration": 1,
                    "maxDuration": 3,
                    "rainIntensityMin": 0.4,
                    "rainIntensityMax": 1.0,
                    "nextStates": ["cloudy", "sunny", "rainy"]
                }
            },
            
            "particles": {
                "maxParticles": 1000,
                "particleSizeMin": 1,
                "particleSizeMax": 3,
                "fallSpeedMin": 200,
                "fallSpeedMax": 400,
                "color": [100, 180, 255, 200],
                "spawnHeightOffset": 50
            },
            
            "splashes": {
                "enabled": true,
                "spawnProbability": 0.15,
                "particleCountMin": 2,
                "particleCountMax": 4,
                "lifetimeMin": 0.1,
                "lifetimeMax": 0.3,
                "speedMin": 20,
                "speedMax": 60,
                "color": [255, 255, 255, 200]
            },
            
            "soilEffects": {
                "rainWaterIncreasePerDay": 15,
                "sunEvaporationPerDay": 5,
                "cloudyEvaporationPerDay": 2,
                "rainNitrogenRestorePerDay": 0.8
            }
        }
    }
}